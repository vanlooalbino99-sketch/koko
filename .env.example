# Copiez ce fichier en .env et adaptez-le.

# Port HTTP du serveur.
PORT=3000

# Dossier des données (base SQLite + images d'ambiance). À sauvegarder.
DATA_DIR=./data

# Derrière un proxy HTTPS (Nginx, Caddy, Render, Railway…) : nombre de proxys de confiance,
# pour que l'adresse IP et le HTTPS soient bien détectés.
# TRUST_PROXY=1

# Force l'attribut « Secure » des cookies (toujours servi en HTTPS).
# COOKIE_SECURE=1

# Facultatif : crée le premier administrateur au démarrage (sinon, création depuis la page de connexion).
# ADMIN_NAME=Albino
# ADMIN_EMAIL=vous@entreprise.fr
# ADMIN_PASSWORD=changez-moi-123
