{
  "name": "blackstart-crm",
  "version": "5.16.0",
  "private": true,
  "description": "Blackstart AI — CRM de prospection : application (un seul fichier HTML) et serveur d'équipe (Node.js + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/src/index.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch-path=server/src server/src/index.js --dev",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\"",
    "test:e2e": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"e2e/*.test.js\"",
    "legacy:v4": "cd legacy/v4 && node build.mjs",
    "legacy:premium": "cd legacy/v3-premium && node build-premium.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "preact": "^10.29.0"
  }
}
