# Copiez ce fichier en .env.local (développement) ou renseignez ces variables chez l'hébergeur.

# Adresse publique du site (balises canoniques, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.blackstart.fr

# --- CRM Blackstart : les demandes de contact et les rendez-vous y arrivent comme leads à rappeler.
# Adresse du serveur du CRM (version équipe) et clé partagée, identique à SITE_API_KEY côté CRM.
CRM_URL=http://localhost:3000
CRM_SITE_KEY=

# --- E-mails automatiques (Resend, https://resend.com). Sans clé, aucun e-mail n'est envoyé.
RESEND_API_KEY=
# Expéditeur : une adresse d'un domaine vérifié dans Resend.
EMAIL_FROM=Blackstart AI <bonjour@blackstart.fr>
# Qui reçoit les notifications de nouvelle demande (plusieurs adresses : séparées par des virgules).
EMAIL_AGENCE=equipe@blackstart.fr
